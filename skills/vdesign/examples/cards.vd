version 4
kind design
title "Three feature cards"
$gap = 24
$paper = #ffffff
$muted = #eef2f7
$ink = #0f172a
$heading = 20
$body = 14

frame page w=1040 h=520 background=paper
  text section.title x=$gap y=$gap w=400 h=24 size=$heading weight=700 fill=ink
    "Three ways in"
  group cards
    rect card.1 x=$gap y=(@section.title.bottom + $gap) w=((100% - $gap * 4) / 3) h=220 fill=muted radius=12
    rect card.2 x=(@card.1.right + $gap) y=(prev.y) w=@card.1.w h=@card.1.h fill=muted radius=12
    rect card.3 x=(@card.2.right + $gap) y=(prev.y) w=@card.1.w h=@card.1.h fill=muted radius=12
  text card.1.label x=(@card.1.left + 16) y=(@card.1.top + 16) w=(@card.1.w - 32) h=17 size=$body weight=600 fill=ink
    "As a format"
  text card.2.label x=(@card.2.left + 16) y=(@card.1.label.top) w=(@card.1.label.w) h=17 size=$body weight=600 fill=ink
    "As an editor"
  text card.3.label x=(@card.3.left + 16) y=(@card.1.label.top) w=(@card.1.label.w) h=17 size=$body weight=600 fill=ink
    "As a protocol"
