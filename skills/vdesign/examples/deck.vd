version 4
kind design
title "Launch plan"
$ink = #101014
$paper = #fafafa
$accent = #d64545
$gap = 64

frame intro x=0 y=0 w=1600 h=900 background=paper
  text intro.title x=$gap y=240 w=1100 h=116 size=96 weight=800 fill=ink
    "Launch plan"
  text intro.sub x=$gap y=(@intro.title.bottom + 24) w=900 h=39 size=32 fill=ink opacity=0.6
    "What ships, when, and what it costs"
  text intro.next x=$gap y=640 w=400 h=34 size=28 weight=700 fill=accent
    "See pricing →"

frame plan x=1700 y=0 w=1600 h=900 background=paper
  text plan.title x=$gap y=$gap w=1000 h=58 size=48 weight=800 fill=ink
    "Three steps"
  text plan.one x=$gap y=320 w=((100% - $gap * 4) / 3) h=192 size=44
    "1 " size=160 fill=accent
    "Beta in May"
  text plan.two x=(@plan.one.right + $gap) y=(prev.y) w=@plan.one.w h=192 size=44
    "2 " size=160 fill=accent
    "Open in June"
  text plan.three x=(@plan.two.right + $gap) y=(prev.y) w=@plan.one.w h=192 size=44
    "3 " size=160 fill=accent
    "Teams in July"

frame pricing x=3400 y=0 w=1600 h=900 background=ink
  text pricing.title x=$gap y=$gap w=1000 h=58 size=48 weight=800 fill=paper
    "Pricing"
  text pricing.price x=$gap y=300 w=800 h=154 size=128 weight=800 fill=accent
    "$49 a month"
  text pricing.back x=$gap y=780 w=200 h=34 size=28 fill=paper
    "← Back"

motion intro enter=fade
  intro.title enter=rise
  intro.sub enter=fade delay=150 together
  intro.next enter=pop go=#pricing

motion plan enter=push
  plan.title enter=fade
  plan.one enter=rise step
  plan.two enter=rise step
  plan.three enter=rise step

motion pricing enter=slide
  pricing.price enter=pop
  pricing.back go=back
