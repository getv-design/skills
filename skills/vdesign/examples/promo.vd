version 9
kind design
title "Pulse launch promo"
$ink = #0e0e12
$paper = #f7f7f2
$lime = #d7ff3a
$muted = #8a8a96
$pad = 88

frame promo x=0 y=0 w=3400 h=1350 background=ink
  frame hook x=0 y=0 w=1080 h=1350 background=ink
    text hook.kicker x=$pad y=360 w=(100% - $pad * 2) h=34 size=26 weight=700 letterSpacing=4 fill=lime
      "INTRODUCING PULSE"
    text hook.title x=$pad y=(@hook.kicker.bottom + 28) w=(100% - $pad * 2) h=360 size=112 weight=800 lineHeight=1.05 fill=paper
      "Reports that "
      "write themselves" fill=lime
    vector hook.underline x=$pad y=(@hook.title.bottom + 12) w=520 h=24 view="0 0 520 24" d="M4 16 C130 2 300 2 516 12" fill=none stroke=lime strokeWidth=8 cap=round
  frame proof x=1160 y=0 w=1080 h=1350 background=ink
    text proof.value x=$pad y=420 w=(100% - $pad * 2) h=170 size=140 weight=800 fill=paper
      "12,480"
    text proof.label x=$pad y=(@proof.value.bottom + 8) w=(100% - $pad * 2) h=40 size=30 fill=muted
      "reports sent last week"
    chart proof.bars x=$pad y=900 w=576 h=340 labels=W1,W2,W3,W4 axis=none gap=27 radius=12 size=26 fill=muted
      series proof.sent values=3100,5200,7900,12480 fill=muted fills=,,,lime
  frame end x=2320 y=0 w=1080 h=1350 background=ink
    text end.logo x=$pad y=520 w=(100% - $pad * 2) h=170 size=140 weight=800 align=center fill=lime
      "pulse"
    text end.cta x=$pad y=(@end.logo.bottom + 24) w=(100% - $pad * 2) h=44 size=34 weight=600 align=center fill=paper
      "Try it free at pulse.app"

motion promo w=1080 h=1350
  camera hook duration=0
  hook.kicker enter=fade duration=500
  hook.title enter=rise by=word stagger=80
  hook.underline enter=draw duration=600
  camera proof delay=400
  proof.value enter=count from=0 together
  proof.label enter=fade with=proof.value
  proof.bars enter=grow by=point after=proof.value
  camera end delay=600
  end.logo enter=pop
  end.cta enter=rise by=word stagger=60
  end.cta emphasis=pulse delay=400
